From 700be7df78e009642af92b56e38eaa8d7ba14db7 Mon Sep 17 00:00:00 2001
From: Mykola Lysenko <mykolal@meta.com>
Date: Sat, 1 Aug 2026 08:26:21 -0700
Subject: [PATCH] selftests/bpf: regenerate signed lskels when the signing key
 changes

The signed light skeleton rule depends on the BPF object, bpftool,
and verification certificate, but not the private key passed to
bpftool through LSKEL_SIGN's -k argument. Updating that input without
changing the certificate leaves the generated signed header stale.

Add $(PRIVATE_KEY) as a real prerequisite alongside the existing
$(VERIFICATION_CERT) dependency so a change to either signing input
regenerates signed skeletons and rebuilds their consumers through the
dependency files.

Signed-off-by: Mykola Lysenko <mykolal@meta.com>
---
 tools/testing/selftests/bpf/Makefile | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tools/testing/selftests/bpf/Makefile b/tools/testing/selftests/bpf/Makefile
index 30d3b94f8..434316a26 100644
--- a/tools/testing/selftests/bpf/Makefile
+++ b/tools/testing/selftests/bpf/Makefile
@@ -662,7 +662,9 @@ $(TRUNNER_BPF_LSKELS): %.lskel.h: %.bpf.o $(BPFTOOL) | $(TRUNNER_OUTPUT)
 	}) && \
 	rm -f $$(<:.o=.llinked1.o) $$(<:.o=.llinked2.o) $$(<:.o=.llinked3.o)
 
-$(TRUNNER_BPF_LSKELS_SIGNED): %.lskel.h: %.bpf.o $(BPFTOOL) $(VERIFICATION_CERT) | $(TRUNNER_OUTPUT)
+$(TRUNNER_BPF_LSKELS_SIGNED): %.lskel.h: %.bpf.o $(BPFTOOL)		\
+			      $(PRIVATE_KEY) $(VERIFICATION_CERT)	\
+			      | $(TRUNNER_OUTPUT)
 	$(Q)$(if $(PERMISSIVE),if [ ! -f $$< ]; then			\
 		$$(RM) $$@;						\
 		printf '  %-12s %s\n' 'SKIP-SKEL' '$$(notdir $$@)' 1>&2; \
