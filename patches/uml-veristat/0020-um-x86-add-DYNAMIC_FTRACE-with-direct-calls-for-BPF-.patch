diff --git a/arch/x86/um/asm/ftrace.h b/arch/x86/um/asm/ftrace.h
new file mode 100644
index 000000000..d0c77d17b
--- /dev/null
+++ b/arch/x86/um/asm/ftrace.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_X86_FTRACE_H
+#define __UM_X86_FTRACE_H
+
+#ifdef CONFIG_FUNCTION_TRACER
+
+#define MCOUNT_ADDR		((unsigned long)(__fentry__))
+#define MCOUNT_INSN_SIZE	5 /* sizeof mcount call */
+
+#ifdef CONFIG_DYNAMIC_FTRACE_WITH_ARGS
+#define ARCH_SUPPORTS_FTRACE_OPS 1
+#endif
+
+#ifndef __ASSEMBLER__
+#include <asm/ptrace.h>
+
+void __fentry__(void);
+
+static inline unsigned long ftrace_call_adjust(unsigned long addr)
+{
+	/*
+	 * addr is the address of the mcount call instruction; -mfentry
+	 * places it at function entry, no adjustment needed.
+	 */
+	return addr;
+}
+
+#ifdef CONFIG_DYNAMIC_FTRACE
+struct dyn_arch_ftrace {
+	/* No extra data needed */
+};
+#endif
+
+#ifdef CONFIG_DYNAMIC_FTRACE_WITH_ARGS
+/*
+ * The default pt_regs-shaped ftrace_regs from linux/ftrace_regs.h is
+ * used; ftrace_caller materializes a partial um pt_regs (argument
+ * registers, ip, sp) on the stack. It is never a complete pt_regs,
+ * so no full-regs view is offered.
+ */
+struct ftrace_regs;
+
+static __always_inline struct pt_regs *
+arch_ftrace_get_regs(struct ftrace_regs *fregs)
+{
+	return NULL;
+}
+
+#define ftrace_regs_set_instruction_pointer(fregs, _ip) \
+	(arch_ftrace_regs(fregs)->regs.regs.gp[HOST_IP] = (_ip))
+
+#ifdef CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS
+/*
+ * When a direct-call ops shares an fentry site with normal ops, the
+ * dispatcher stashes the direct trampoline's address in the frame's
+ * ORIG_AX slot; ftrace_caller tail-jumps to it after the ops loop.
+ */
+static inline void
+__arch_ftrace_set_direct_caller(struct pt_regs *regs, unsigned long addr)
+{
+	regs->regs.gp[HOST_ORIG_AX] = addr;
+}
+
+#define arch_ftrace_set_direct_caller(fregs, addr) \
+	__arch_ftrace_set_direct_caller(&arch_ftrace_regs(fregs)->regs, addr)
+#endif /* CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS */
+#endif /* CONFIG_DYNAMIC_FTRACE_WITH_ARGS */
+#endif /* !__ASSEMBLER__ */
+
+#endif /* CONFIG_FUNCTION_TRACER */
+#endif /* __UM_X86_FTRACE_H */
