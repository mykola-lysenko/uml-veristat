diff --git a/arch/um/kernel/ftrace.c b/arch/um/kernel/ftrace.c
new file mode 100644
index 000000000..309246cf6
--- /dev/null
+++ b/arch/um/kernel/ftrace.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Dynamic ftrace support for UML, x86_64 subarch.
+ *
+ * The UML kernel is a host process: its .text is mapped r-x by the host
+ * ELF loader, and patching it is a matter of toggling host page
+ * protections around a plain memcpy — no cross-CPU coherency dance is
+ * needed beyond the stop_machine() the ftrace core already runs for
+ * code modification.
+ */
+
+#include <linux/ftrace.h>
+#include <linux/kernel.h>
+#include <linux/memory.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include <asm/nops.h>
+#include <os.h>
+
+static const char ftrace_nop[MCOUNT_INSN_SIZE] = { BYTES_NOP5 };
+
+union ftrace_code_union {
+	char code[MCOUNT_INSN_SIZE];
+	struct {
+		char op;
+		int offset;
+	} __packed;
+};
+
+static void ftrace_call_replace(char *code, unsigned long ip,
+				unsigned long addr)
+{
+	union ftrace_code_union calc;
+
+	calc.op = 0xe8; /* call rel32 */
+	calc.offset = (int)(addr - ip - MCOUNT_INSN_SIZE);
+	memcpy(code, calc.code, MCOUNT_INSN_SIZE);
+}
+
+/* old_code == NULL skips the expected-bytes check (unknown old target). */
+static int ftrace_poke(unsigned long ip, const char *old_code,
+		       const char *new_code)
+{
+	unsigned long page = ip & PAGE_MASK;
+	unsigned long span = PAGE_ALIGN(ip + MCOUNT_INSN_SIZE) - page;
+	char cur[MCOUNT_INSN_SIZE];
+	int err;
+
+	/* Make sure we are replacing what we think we are. */
+	if (old_code) {
+		if (copy_from_kernel_nofault(cur, (void *)ip, MCOUNT_INSN_SIZE))
+			return -EFAULT;
+		if (memcmp(cur, old_code, MCOUNT_INSN_SIZE) != 0)
+			return -EINVAL;
+	}
+
+	err = os_protect_memory((void *)page, span, 1, 1, 1);
+	if (err)
+		return err;
+	memcpy((void *)ip, new_code, MCOUNT_INSN_SIZE);
+	err = os_protect_memory((void *)page, span, 1, 0, 1);
+
+	return err;
+}
+
+int ftrace_make_nop(struct module *mod, struct dyn_ftrace *rec,
+		    unsigned long addr)
+{
+	char old[MCOUNT_INSN_SIZE];
+
+	ftrace_call_replace(old, rec->ip, addr);
+	return ftrace_poke(rec->ip, old, ftrace_nop);
+}
+
+int ftrace_make_call(struct dyn_ftrace *rec, unsigned long addr)
+{
+	char new[MCOUNT_INSN_SIZE];
+
+	ftrace_call_replace(new, rec->ip, addr);
+	return ftrace_poke(rec->ip, ftrace_nop, new);
+}
+
+#ifdef CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS
+int ftrace_modify_call(struct dyn_ftrace *rec, unsigned long old_addr,
+		       unsigned long addr)
+{
+	char old[MCOUNT_INSN_SIZE], new[MCOUNT_INSN_SIZE];
+
+	ftrace_call_replace(old, rec->ip, old_addr);
+	ftrace_call_replace(new, rec->ip, addr);
+	return ftrace_poke(rec->ip, old, new);
+}
+#endif
+
+int ftrace_update_ftrace_func(ftrace_func_t func)
+{
+	unsigned long ip = (unsigned long)&ftrace_call;
+	char new[MCOUNT_INSN_SIZE];
+
+	ftrace_call_replace(new, ip, (unsigned long)func);
+	return ftrace_poke(ip, NULL, new);
+}
