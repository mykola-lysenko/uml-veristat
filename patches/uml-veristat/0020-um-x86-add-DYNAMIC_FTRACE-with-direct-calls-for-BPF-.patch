diff --git a/arch/x86/um/ftrace_64.S b/arch/x86/um/ftrace_64.S
new file mode 100644
index 000000000..23d4e55da
--- /dev/null
+++ b/arch/x86/um/ftrace_64.S
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * ftrace entry code for UML x86_64.
+ *
+ * DYNAMIC_FTRACE_WITH_ARGS flavor: ftrace_caller materializes a partial
+ * um pt_regs (argument registers, ip, sp) on the stack and calls the
+ * dispatcher with (ip, parent_ip, op, fregs). Native x86's ftrace_64.S
+ * is not reusable here — it leans on CET, %gs-based per-CPU state and
+ * ORC annotations that do not exist on UML.
+ *
+ * um pt_regs is a flat gp[] array indexed by the generated HOST_*
+ * constants, so every register slot is HOST_xx * 8 from the frame base.
+ */
+
+#include <linux/linkage.h>
+#include <generated/user_constants.h>
+#include <generated/asm-offsets.h>
+
+/* rsp is 8 (mod 16) on entry; keep the call site 16-byte aligned. */
+#define FTRACE_FRAME_SIZE	(((UM_PT_REGS_SIZE + 15) & ~15) + 8)
+
+#define SLOT(reg)		((HOST_##reg) * 8)
+
+	.code64
+
+/* All fentry sites are nopped at boot; __fentry__ itself is never live. */
+SYM_FUNC_START(__fentry__)
+	ret
+SYM_FUNC_END(__fentry__)
+EXPORT_SYMBOL(__fentry__)
+
+SYM_FUNC_START(ftrace_caller)
+	/*
+	 * Stack on entry:
+	 *   [rsp]    return address into the traced function (site ip + 5)
+	 *   [rsp+8]  traced function's return address (parent ip)
+	 */
+	subq	$FTRACE_FRAME_SIZE, %rsp
+
+	/* Preserve the traced function's argument registers plus rax
+	 * (varargs %al count); callee-saved registers are covered by the
+	 * C ABI of the dispatcher. */
+	movq	%rdi, SLOT(DI)(%rsp)
+	movq	%rsi, SLOT(SI)(%rsp)
+	movq	%rdx, SLOT(DX)(%rsp)
+	movq	%rcx, SLOT(CX)(%rsp)
+	movq	%r8,  SLOT(R8)(%rsp)
+	movq	%r9,  SLOT(R9)(%rsp)
+	movq	%rax, SLOT(AX)(%rsp)
+	movq	%rbp, SLOT(BP)(%rsp)
+
+	/* ip of the fentry site: return-into-function minus call size */
+	movq	FTRACE_FRAME_SIZE(%rsp), %rdi
+	subq	$5, %rdi
+	movq	%rdi, SLOT(IP)(%rsp)
+
+	/* sp as the uninstrumented function would see it */
+	leaq	FTRACE_FRAME_SIZE+8(%rsp), %rax
+	movq	%rax, SLOT(SP)(%rsp)
+
+	/* direct-call stash, read back after the ops loop */
+	movq	$0, SLOT(ORIG_AX)(%rsp)
+
+	movq	FTRACE_FRAME_SIZE+8(%rsp), %rsi	/* parent ip */
+	movq	function_trace_op(%rip), %rdx	/* op */
+	movq	%rsp, %rcx			/* fregs */
+
+SYM_INNER_LABEL(ftrace_call, SYM_L_GLOBAL)
+	call	ftrace_stub
+
+	/* A direct-call ops sharing this site leaves its trampoline
+	 * address in ORIG_AX; r11 is fair game at function entry. */
+	movq	SLOT(ORIG_AX)(%rsp), %r11
+
+	movq	SLOT(BP)(%rsp), %rbp
+	movq	SLOT(AX)(%rsp), %rax
+	movq	SLOT(R9)(%rsp), %r9
+	movq	SLOT(R8)(%rsp), %r8
+	movq	SLOT(CX)(%rsp), %rcx
+	movq	SLOT(DX)(%rsp), %rdx
+	movq	SLOT(SI)(%rsp), %rsi
+	movq	SLOT(DI)(%rsp), %rdi
+	addq	$FTRACE_FRAME_SIZE, %rsp
+
+	testq	%r11, %r11
+	jnz	1f
+	ret
+1:
+	/* Enter the trampoline exactly as a patched site call would. */
+	jmp	*%r11
+SYM_FUNC_END(ftrace_caller)
+
+SYM_FUNC_START(ftrace_stub)
